{
  "name": "@jimbly/zopflipng-bin",
  "version": "1.0.0",
  "description": "`zopflipng` wrapper that makes it seamlessly available as a local dependency",
  "license": "MIT",
  "type": "module",
  "exports": "./index.js",
  "author": "Jimb Esser (https://github.com/Jimbly)",
  "homepage": "https://github.com/Jimbly/zopflipng-bin#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:Jimbly/npm-publish.git"
  },
  "bin": {
    "zopflipng": "cli.js"
  },
  "engines": {
    "node": "^14.13.1 || >=16.0.0"
  },
